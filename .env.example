# PTPetho CTF - Environment Configuration
# Copy this file to .env and adjust values as needed

# Database Configuration
DB_HOST=db
DB_NAME=ptpetho_internal
DB_USER=ptpetho
DB_PASS=ptpetho_secret

# MySQL Root Password (for initial setup)
MYSQL_ROOT_PASSWORD=root_secret_2026

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Logger URL (for XSS demo - students will use this)
LOGGER_URL=http://localhost:8000

# Session Settings
SESSION_LIFETIME=3600
